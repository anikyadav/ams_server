NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://audit:audit_local_only@localhost:5432/audit_sas?schema=public
# Optional direct database URL for Prisma migrations when DATABASE_URL uses pooling.
DIRECT_URL=
# Replace with a random secret of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:3000
# Required only for initial development seed. Choose your own password.
SEED_PASSWORD=
# Required for IRD passwords. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key backed up; changing it makes existing passwords unreadable.
# IRD_CREDENTIAL_ENCRYPTION_KEY=
