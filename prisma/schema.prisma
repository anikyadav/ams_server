generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  AUDITOR
  STAFF
}

enum EngagementStatus {
  NOT_STARTED
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETE
  DELIVERED
}

enum SubTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  irdAccess IrdCredentialAccessLog[]
  submittedTasks SubTask[] @relation("SubTaskSubmitter")
  reviewedTasks SubTask[] @relation("SubTaskReviewer")
  checklistDone TaskChecklistItem[] @relation("ChecklistDoneBy")
  requestsCreated DocumentRequest[] @relation("RequestCreator")
  requestsReceived DocumentRequest[] @relation("RequestReceiver")
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         Role
  engagements  Engagement[] @relation("PrimaryStaff")
  subTasks     SubTask[]
  comments     Comment[]
  activity     ActivityLog[]
  notifications Notification[]
  createdAt    DateTime     @default(now())
}

model FiscalYear {
  irdAccess IrdCredentialAccessLog[]
  id String @id @default(cuid())
  startDate DateTime? @unique @db.Date
  endDate DateTime? @db.Date
  clients Client[]
  engagements Engagement[]
  createdAt DateTime @default(now())
}

model Client {
  irdCredential ClientIrdCredential?
  fiscalYearId String @default("legacy")
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  lineageId String @default(cuid())
  @@unique([fiscalYearId, lineageId])
  @@unique([id, fiscalYearId])
  id          String       @id @default(cuid())
  name        String
  pan         String       @db.VarChar(9)
  fileLocation String
  location    String?
  engagements Engagement[]
  createdAt   DateTime     @default(now())
}

model Engagement {
  manualProgress Int?
  fiscalYearId String @default("legacy")
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  @@index([fiscalYearId])
  id           String           @id @default(cuid())
  client       Client           @relation(fields: [clientId, fiscalYearId], references: [id, fiscalYearId], onDelete: Restrict)
  clientId     String
  natureOfWork String
  status       EngagementStatus @default(NOT_STARTED)
  staff        User             @relation("PrimaryStaff", fields: [staffId], references: [id], onDelete: Restrict)
  staffId      String
  startDate    DateTime?
  targetDate   DateTime?
  priority     String?
  subTasks     SubTask[]
  documentRequests DocumentRequest[]
  comments     Comment[]
  activity     ActivityLog[]
  notifications Notification[]
  createdAt    DateTime         @default(now())

  @@index([clientId])
  @@index([staffId])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReviewState {
  NOT_SUBMITTED
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
}

enum DocumentRequestStatus {
  REQUESTED
  RECEIVED
}

model SubTask {
  reviewState ReviewState @default(NOT_SUBMITTED)
  submittedAt DateTime?
  submittedBy User? @relation("SubTaskSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedById String?
  reviewedAt DateTime?
  reviewedBy User? @relation("SubTaskReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById String?
  reviewNote String?
  blockedReason String?
  blockedAt DateTime?
  checklist TaskChecklistItem[]
  @@unique([engagementId, templateKey])
  templateKey String?
  sortOrder Int @default(100)
  dueDate DateTime? @db.Date
  priority TaskPriority @default(MEDIUM)
  id           String        @id @default(cuid())
  engagement   Engagement    @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String
  title        String
  description  String?
  status       SubTaskStatus @default(TODO)
  progress     Int           @default(0)
  assignedTo   User          @relation(fields: [assignedToId], references: [id], onDelete: Restrict)
  assignedToId String
  comments     Comment[]
  completedAt  DateTime?
  createdAt    DateTime      @default(now())

  @@index([engagementId])
  @@index([assignedToId])
}

model TaskChecklistItem {
  id String @id @default(cuid())
  subTask SubTask @relation(fields: [subTaskId], references: [id], onDelete: Cascade)
  subTaskId String
  text String
  done Boolean @default(false)
  doneAt DateTime?
  doneBy User? @relation("ChecklistDoneBy", fields: [doneById], references: [id], onDelete: SetNull)
  doneById String?
  sortOrder Int @default(100)
  createdAt DateTime @default(now())

  @@index([subTaskId])
}

model DocumentRequest {
  id String @id @default(cuid())
  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String
  title String
  description String?
  dueDate DateTime? @db.Date
  status DocumentRequestStatus @default(REQUESTED)
  reference String?
  receivedAt DateTime?
  receivedBy User? @relation("RequestReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  receivedById String?
  createdBy User @relation("RequestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdById String
  createdAt DateTime @default(now())

  @@index([engagementId])
}

model ClientIrdCredential {
  clientId String @id
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  registrationNo String? @db.VarChar(200)
  userId String? @db.VarChar(200)
  passwordEncrypted String?
  nextRenewalDate DateTime? @db.Date
  updatedAt DateTime @updatedAt
}

model IrdCredentialAccessLog {
  id String @id @default(cuid())
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  fiscalYearId String
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  clientId String?
  action String
  createdAt DateTime @default(now())
  @@index([fiscalYearId, createdAt])
}

model Comment {
  id           String     @id @default(cuid())
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String
  subTask      SubTask?   @relation(fields: [subTaskId], references: [id], onDelete: Cascade)
  subTaskId    String?
  author       User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId     String
  text         String
  createdAt    DateTime   @default(now())

  @@index([engagementId, createdAt])
  @@index([subTaskId])
}

model ActivityLog {
  id           String     @id @default(cuid())
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String
  actor        User       @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorId      String
  subTaskId    String?
  action       String
  summary      String
  createdAt    DateTime   @default(now())

  @@index([engagementId, createdAt])
  @@index([subTaskId])
}

model Notification {
  id           String      @id @default(cuid())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  type         String
  title        String
  message      String
  engagement   Engagement? @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String?
  subTaskId    String?
  dedupeKey    String?
  readAt       DateTime?
  createdAt    DateTime    @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}
