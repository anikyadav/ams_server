generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  AUDITOR
  STAFF
}

enum EngagementStatus {
  NOT_STARTED
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETE
  DELIVERED
}

enum SubTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         Role
  engagements  Engagement[] @relation("PrimaryStaff")
  subTasks     SubTask[]
  comments     Comment[]
  activity     ActivityLog[]
  notifications Notification[]
  createdAt    DateTime     @default(now())
}

model FiscalYear {
  id String @id @default(cuid())
  startDate DateTime? @unique @db.Date
  endDate DateTime? @db.Date
  clients Client[]
  engagements Engagement[]
  createdAt DateTime @default(now())
}

model Client {
  fiscalYearId String @default("legacy")
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  lineageId String @default(cuid())
  @@unique([fiscalYearId, lineageId])
  @@unique([id, fiscalYearId])
  id          String       @id @default(cuid())
  name        String
  pan         String       @db.VarChar(9)
  fileLocation String
  location    String?
  engagements Engagement[]
  createdAt   DateTime     @default(now())
}

model Engagement {
  manualProgress Int?
  fiscalYearId String @default("legacy")
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  @@index([fiscalYearId])
  id           String           @id @default(cuid())
  client       Client           @relation(fields: [clientId, fiscalYearId], references: [id, fiscalYearId], onDelete: Restrict)
  clientId     String
  natureOfWork String
  status       EngagementStatus @default(NOT_STARTED)
  staff        User             @relation("PrimaryStaff", fields: [staffId], references: [id], onDelete: Restrict)
  staffId      String
  startDate    DateTime?
  targetDate   DateTime?
  priority     String?
  subTasks     SubTask[]
  comments     Comment[]
  activity     ActivityLog[]
  notifications Notification[]
  createdAt    DateTime         @default(now())

  @@index([clientId])
  @@index([staffId])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SubTask {
  dueDate DateTime? @db.Date
  priority TaskPriority @default(MEDIUM)
  id           String        @id @default(cuid())
  engagement   Engagement    @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String
  title        String
  description  String?
  status       SubTaskStatus @default(TODO)
  progress     Int           @default(0)
  assignedTo   User          @relation(fields: [assignedToId], references: [id], onDelete: Restrict)
  assignedToId String
  comments     Comment[]
  completedAt  DateTime?
  createdAt    DateTime      @default(now())

  @@index([engagementId])
  @@index([assignedToId])
}

model Comment {
  id           String     @id @default(cuid())
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String
  subTask      SubTask?   @relation(fields: [subTaskId], references: [id], onDelete: Cascade)
  subTaskId    String?
  author       User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId     String
  text         String
  createdAt    DateTime   @default(now())

  @@index([engagementId, createdAt])
  @@index([subTaskId])
}

model ActivityLog {
  id           String     @id @default(cuid())
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String
  actor        User       @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorId      String
  subTaskId    String?
  action       String
  summary      String
  createdAt    DateTime   @default(now())

  @@index([engagementId, createdAt])
  @@index([subTaskId])
}

model Notification {
  id           String      @id @default(cuid())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  type         String
  title        String
  message      String
  engagement   Engagement? @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  engagementId String?
  subTaskId    String?
  dedupeKey    String?
  readAt       DateTime?
  createdAt    DateTime    @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}
